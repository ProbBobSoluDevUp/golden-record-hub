{
  "modelName": "Golden Record Hub",
  "version": "1.0",
  "objectTypes": [
    {
      "id": "product",
      "name": "Product",
      "attributes": [
        {
          "id": "sku",
          "name": "SKU",
          "type": "string",
          "required": true
        },
        {
          "id": "productName",
          "name": "Product Name",
          "type": "string",
          "required": true
        },
        {
          "id": "brand",
          "name": "Brand",
          "type": "string",
          "required": false
        },
        {
          "id": "category",
          "name": "Category",
          "type": "string",
          "required": false
        },
        {
          "id": "quantityOnHand",
          "name": "Quantity On Hand",
          "type": "integer",
          "required": true
        },
        {
          "id": "quantityOnOrder",
          "name": "Quantity On Order",
          "type": "integer",
          "required": true
        },
        {
          "id": "status",
          "name": "Product Status",
          "type": "lov",
          "required": true,
          "listOfValuesId": "productStatus"
        },
        {
          "id": "availabilityStatus",
          "name": "Availability Status",
          "type": "lov",
          "required": true,
          "listOfValuesId": "availabilityStatus"
        }
      ]
    }
  ],
  "listsOfValues": [
    {
      "id": "productStatus",
      "name": "Product Status",
      "values": ["ACTIVE", "INACTIVE", "DISCONTINUED"]
    },
    {
      "id": "availabilityStatus",
      "name": "Availability Status",
      "values": ["IN_STOCK", "ON_ORDER", "NEEDS_ORDER", "DISCONTINUED"]
    }
  ]
}
